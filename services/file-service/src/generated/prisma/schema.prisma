generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id        String   @id @default(cuid())
  todoId    String
  userId    String
  s3Key     String   @unique
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  @@index([todoId, userId])
}
